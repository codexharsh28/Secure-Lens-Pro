# Gemini powers the assistant and primary message/URL analysis.
GEMINI_API_KEY=

# Optional fallback for message classification.
HUGGING_FACE_API_KEY=

# Firebase Admin service account credentials. Keep the private key server-side.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated web origins. Set exact production origins when deployed.
CORS_ORIGINS=*
